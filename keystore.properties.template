# リリース署名設定テンプレート
# このファイルをコピーして keystore.properties を作成し、実際の値を入力してください。
# keystore.properties は絶対に git にコミットしないこと。
#
# キーストア生成コマンド（初回のみ）:
#   keytool -genkey -v \
#     -keystore dj-app-release.jks \
#     -alias dj-app-release \
#     -keyalg RSA \
#     -keysize 2048 \
#     -validity 10000
#
# 生成した dj-app-release.jks はプロジェクトルートに置いてください。

# キーストアファイルのパス（プロジェクトルートからの相対パス）
storeFile=dj-app-release.jks

# キーストアのパスワード
storePassword=YOUR_STORE_PASSWORD

# キーのエイリアス
keyAlias=dj-app-release

# キーのパスワード
keyPassword=YOUR_KEY_PASSWORD
